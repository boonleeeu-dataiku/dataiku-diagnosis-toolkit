{
  "mcpServers": {
    "dataiku-diagnosis-reader": {
      "command": "node",
      "args": ["${CLAUDE_PLUGIN_ROOT}/mcp-server/dist/index.js"],
      "env": {
        "DATAIKU_SKILL_DIR": "${CLAUDE_PLUGIN_ROOT}/skills/dataiku-diagnosis-reader"
      }
    },
    "dataiku-review-generator": {
      "command": "${CLAUDE_PLUGIN_ROOT}/mcp-server-review-generator/.venv/bin/python3",
      "args": ["${CLAUDE_PLUGIN_ROOT}/mcp-server-review-generator/scripts/mcp_server.py"]
    }
  }
}
